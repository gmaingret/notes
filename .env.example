# Database
DATABASE_URL=postgresql://notes_user:changeme@db:5432/notes_db
DB_NAME=notes_db
DB_USER=notes_user
DB_PASSWORD=changeme

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-string

# Google OAuth
# GOOGLE_CLIENT_ID/SECRET are the Web OAuth client — used by the browser flow
# (passport-google-oauth20) AND accepted as a valid audience on /auth/google/token.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=https://notes.gregorymaingret.fr/api/auth/google/callback
# GOOGLE_ANDROID_CLIENT_ID is the Android OAuth client — used by the native
# Android Credential Manager flow. Tokens issued for this client are also
# accepted on /auth/google/token (additional valid audience).
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# App
PORT=3000
NODE_ENV=production

# Upload settings (consumed by multer in server/src/routes/attachments.ts)
UPLOAD_MAX_SIZE_MB=100
UPLOAD_PATH=/data/attachments
